#!/usr/bin/env bash
set -eo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
: "${TINKER_WS:?TINKER_WS must name the external Humble workspace}"
workspace="${TINKER_WS}"

source /opt/ros/humble/setup.bash
source "${project_root}/.ros-vendor/humble/local_setup.bash"
source "${workspace}/install/setup.bash"
set -u
cd "${project_root}/ros2_ws"
# Build memory safety: FORCE the compiler job/load cap to exactly -j2 -l2 and
# bound colcon package workers; a pre-set higher MAKEFLAGS cannot escape it.
export MAKEFLAGS="-j2 -l2"
exec colcon build --symlink-install --parallel-workers 2 \
  --packages-select tinker_sim_interfaces tinker_sim_bridge
