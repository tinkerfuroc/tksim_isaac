<?xml version="1.0"?>
<package format="3">
  <name>tinker_sim_nav_plugins</name>
  <version>0.1.0</version>
  <description>Nav2 plugins for the simulated robot: a goal checker whose xy latch survives replans.</description>
  <maintainer email="tinker@example.invalid">Tinker Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>angles</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_core</depend>
  <depend>nav2_util</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/plugins.xml"/>
  </export>
</package>
