#usda 1.0
(
    defaultPrim = "TaskObject"
    upAxis = "Z"
    metersPerUnit = 1
)
def Xform "TaskObject" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
)
{
    def Cube "Body" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.08
        color3f[] primvars:displayColor = [(0.8, 0.15, 0.05)]
        double3 xformOp:translate = (0, 0, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
