#usda 1.0
(
    defaultPrim = "QualificationGraspPedestal"
    upAxis = "Z"
    metersPerUnit = 1
)
def Xform "QualificationGraspPedestal"
{
    # Narrow support keeps the wrist clear during direct grasp qualification.
    def Cube "Body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        double3 xformOp:scale = (0.06, 0.06, 0.60)
        double3 xformOp:translate = (0, 0, 0.30)
        color3f[] primvars:displayColor = [(0.22, 0.25, 0.30)]
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
