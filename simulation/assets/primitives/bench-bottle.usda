#usda 1.0
(
    defaultPrim = "BenchBottle"
    upAxis = "Z"
    metersPerUnit = 1
)
def Xform "BenchBottle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.25
    def Cylinder "Body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double radius = 0.035
        double height = 0.19
        uniform token axis = "Z"
        double3 xformOp:translate = (0, 0, 0.095)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.15, 0.45, 0.75)]
        rel material:binding:physics = </BenchBottle/PhysicsMat> (
            bindMaterialAs = "weakerThanDescendants"
        )
    }

    def Material "PhysicsMat" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 1.0
        float physics:dynamicFriction = 1.0
        float physics:restitution = 0.0
    }
}
