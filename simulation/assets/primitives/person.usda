#usda 1.0
(
    defaultPrim = "Person"
    upAxis = "Z"
    metersPerUnit = 1
)
def Xform "Person" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
)
{
    def Capsule "Body" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        float radius = 0.25
        float height = 1.2
        token axis = "Z"
        double3 xformOp:translate = (0, 0, 0.85)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
