#usda 1.0
(
    defaultPrim = "BenchPlate"
    upAxis = "Z"
    metersPerUnit = 1
)
def Xform "BenchPlate" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.3
    def Cylinder "Disc" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double radius = 0.10
        double height = 0.025
        uniform token axis = "Z"
        double3 xformOp:translate = (0, 0, 0.0125)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.24, 0.60, 0.30)]
        rel material:binding:physics = </BenchPlate/PhysicsMat> (
            bindMaterialAs = "weakerThanDescendants"
        )
    }

    def Material "PhysicsMat" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 1.0
        float physics:dynamicFriction = 1.0
        float physics:restitution = 0.0
    }
}
