#usda 1.0
(
    defaultPrim = "BenchKnife"
    upAxis = "Z"
    metersPerUnit = 1
)
def Xform "BenchKnife" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.08
    def Cube "Blade" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        float3 xformOp:scale = (0.20, 0.03, 0.025)
        double3 xformOp:translate = (0, 0, 0.0125)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.72)]
    }
}
