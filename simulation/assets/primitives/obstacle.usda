#usda 1.0
(
    defaultPrim = "Obstacle"
    upAxis = "Z"
    metersPerUnit = 1
)
def Xform "Obstacle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = true
    def Cube "Body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 0.30
        color3f[] primvars:displayColor = [(0.20, 0.20, 0.24)]
        double3 xformOp:translate = (0, 0, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
