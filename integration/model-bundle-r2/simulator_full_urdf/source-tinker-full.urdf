  <!-- Ballast: 20 kg lumped mass for batteries + main electronics tray
       + onboard computer that the real Tinker carries on the chassis
       but are NOT in the tracer_mini SolidWorks CAD (chassis-only,
       40.95 kg). Placed at the chassis horizontal-CoM (-0.125, 0)
       just above the chassis floor (z=+0.08, ~5 cm above chassis
       bottom at +0.03), keeping the lumped CoM low for stability.
       Translucent box visual so it's identifiable in the viewport
       without being mistaken for chassis hardware. -->
  <link name="ballast">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="20.0"/>
      <!-- ~30x30x20 cm box, m*(h²+d²)/12 etc. -->
      <inertia ixx="0.22" ixy="0" ixz="0" iyy="0.30" iyz="0" izz="0.22"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.20"/>
      </geometry>
      <material name="ballast_color">
        <color rgba="0.3 0.3 0.4 0.4"/>
      </material>
    </visual>
  </link>
  <joint name="ballast_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.125 0 0.08"/>
    <parent link="base_link"/>
    <child link="ballast"/>
  </joint>
  <!-- ===============================================================
       Livox Mid-360 mount — physical placement matches the reference
       gazebo nav-only snapshot
       (src/tk26_sim/reference/tinker_gazebo_snapshot/
         tinker_description/urdf/tinker.urdf.xacro):
       9 cm ahead of base_link, centred laterally, 5 cm above the
       lower-chassis deck.

       X/Y match the snapshot's (0.09, 0) 1:1 — tinker_full's
       tracer-frame +X is treated as robot-forward (consistent with
       the wheel rig + diff_drive integration). Z, however, does NOT
       port across 1:1: the snapshot's base_link sits ~21.5 cm above
       ground (front-axle midpoint at chassis-deck level), while
       tracer base_link sits ~7.75 cm above ground (per the
       file-header spawn comment). Using snap's z=0.05 verbatim would
       place the Livox 2 cm above the chassis-bottom, not the deck.

       To preserve the snapshot's PHYSICAL placement, derive tracer-Z
       from the chassis-mesh extents declared in this file's header
       docstring (`chassis bottom is at +0.03 in base_link frame`):
       lower-chassis box (height ≈ 0.165 m, matches snapshot) puts
       the deck at tracer-Z ≈ 0.03 + 0.165 ≈ 0.195. User tuned this
       visually (2026-05-26 render) — the sensor sits FLUSH with the
       chassis deck (no air gap), since the real Mid-360 is screwed
       directly onto the chassis top plate. So `z = 0.195`.

       Inertia + mass: Mid-360 spec (~0.265 kg per Livox datasheet,
       rounded to 0.25 kg here). The legacy 1.596 kg Velodyne value
       carried over from the snapshot was ~6× too heavy. Joint is
       fixed, so PhysX only uses mass for total-mass aggregation,
       not for dynamics about this link — but accurate mass keeps
       the chassis CoM correct. Inertia is a solid-cylinder
       approximation (radius 0.035 m, height 0.060 m) about the
       sensor's own axis: I = m·(3r²+h²)/12 ≈ 1.52e-4 (XX/YY),
       I = m·r²/2 ≈ 1.53e-4 (ZZ).

       Collision is a user-measured 6 × 10.5 × 6 cm box (2026-04-21,
       see snapshot comment); the visual mesh `mid_360.stl` is the
       actual Mid-360 sensor body, baked from the upstream
       `mid-360-scaled.dae` (vendored from
       https://github.com/LCAS/livox_laser_simulation_ros2 — MIT
       license, attribution in meshes/mid_360.dae.LICENSE).

       Why the .stl and not the .dae directly: the upstream .dae has
       nested COLLADA node transforms (an internal 0.001 mm→m scale
       plus a Z-up swizzle) that Isaac Sim's URDF importer doesn't
       honor end-to-end, so referencing the .dae rendered as a giant
       ~70 m spike. We pre-baked the mesh via trimesh
       (collapses all instances + applies node transforms) into a
       flat .stl already at correct meter scale (~7.3 × 6.5 × 6.0 cm)
       and recentered so the sensor sits on `livox_frame` Z=0.
       Scaling: NONE — the .stl is in metres directly. The bracket
       `livox_mount.STL` carried over from the snapshot is no longer
       referenced here — we surface the SENSOR, not the bracket.

       No <gazebo> block — render_for_isaac.sh strips all <gazebo>
       elements, and a sim-side Livox sensor (Isaac RtxLidar) is a
       separate follow-up.
       =============================================================== -->
  <link name="livox_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.030"/>
      <mass value="0.25"/>
      <!-- Solid-cylinder approximation: r=0.035, h=0.060, m=0.25
           Ixx = Iyy = m*(3r² + h²)/12 = 1.52e-4 kg·m²
           Izz       = m*r²/2          = 1.53e-4 kg·m² -->
      <inertia ixx="1.52e-4" ixy="0" ixz="0" iyy="1.52e-4" iyz="0" izz="1.53e-4"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://isaac_nav_bringup/meshes/mid_360.stl"/>
      </geometry>
      <material name="livox_black">
        <color rgba="0.10 0.10 0.10 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.01 0 -0.02"/>
      <geometry>
        <box size="0.06 0.105 0.06"/>
      </geometry>
    </collision>
  </link>
  <joint name="livox_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin rpy="0 0 0" xyz="0.09 0 0.195"/>
  </joint>
  <link name="front_left_wheel">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0010198125" ixy="0" ixz="0" iyy="0.0013781249999999998" iyz="0" izz="0.0010198125"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.063" radius="0.0525"/>
      </geometry>
      <material name="wheel_rubber">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.063" radius="0.0525"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin rpy="0 0 0" xyz="0.0  0.125 -0.025"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="20.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="front_right_wheel">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0010198125" ixy="0" ixz="0" iyy="0.0013781249999999998" iyz="0" izz="0.0010198125"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.063" radius="0.0525"/>
      </geometry>
      <material name="wheel_rubber">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.063" radius="0.0525"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin rpy="0 0 0" xyz="0.0 -0.125 -0.025"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="20.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <!-- Swivel yoke -->
  <link name="rear_left_swivel">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="rear_left_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_swivel"/>
    <origin rpy="0 0 0" xyz="-0.25  0.125 -0.0475"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <!-- Rolling wheel, trailing behind the swivel along -X -->
  <link name="rear_left_wheel">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00013854166666666667" ixy="0" ixz="0" iyy="0.000225" iyz="0" izz="0.00013854166666666667"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.03"/>
      </geometry>
      <material name="wheel_rubber">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.03"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="rear_left_swivel"/>
    <child link="rear_left_wheel"/>
    <origin rpy="0 0 0" xyz="-0.025 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="40.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <!-- Swivel yoke -->
  <link name="rear_right_swivel">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="rear_right_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_swivel"/>
    <origin rpy="0 0 0" xyz="-0.25 -0.125 -0.0475"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <!-- Rolling wheel, trailing behind the swivel along -X -->
  <link name="rear_right_wheel">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00013854166666666667" ixy="0" ixz="0" iyy="0.000225" iyz="0" izz="0.00013854166666666667"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.03"/>
      </geometry>
      <material name="wheel_rubber">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.03"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="rear_right_swivel"/>
    <child link="rear_right_wheel"/>
    <origin rpy="0 0 0" xyz="-0.025 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="40.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
</robot>
